rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 1000 &&
             data.price is number && data.price >= 0;
    }

    function isValidInquiry(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.productId is string && data.productId.size() <= 128 &&
             data.productTitle is string && data.productTitle.size() <= 500;
    }

    // Only allow writes if authenticated (assuming basic auth for now, can be hardened later)
    function isAdmin() {
      return request.auth != null;
    }

    // Public catalog: viewable by all visitors worldwide
    match /products/{productId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidId(productId) && isValidProduct(request.resource.data);
      allow delete: if isAdmin() && isValidId(productId);
    }

    // Customer WhatsApp inquiry logs: Allow creating, but not deleting/updating
    match /inquiries/{inquiryId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(inquiryId) && isValidInquiry(request.resource.data);
      allow update, delete: if false;
    }

    // Connection health check document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
