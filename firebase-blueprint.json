{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A product in the catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique product ID" },
        "title": { "type": "string", "description": "Product title" },
        "price": { "type": "number", "description": "Product price" }
      },
      "required": ["id", "title", "price"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "A customer inquiry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique inquiry ID" },
        "productId": { "type": "string", "description": "Related product ID" }
      },
      "required": ["id", "productId"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "Product" },
      "description": "Catalog products"
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "Inquiry" },
      "description": "Customer inquiries"
    }
  }
}
