{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Boutique catalog product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "sizes": { "type": "array", "items": { "type": "string" } },
        "stockCount": { "type": "number" },
        "sizeStock": { "type": "object" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "fabricDetails": { "type": "string" },
        "inStock": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "isNewArrival": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "category", "price", "imageUrl"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "WhatsApp customer inquiry logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "productTitle": { "type": "string" },
        "selectedSize": { "type": "string" },
        "phoneContact": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["productTitle", "timestamp"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalog products collection"
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "WhatsApp customer order inquiries"
    }
  }
}
